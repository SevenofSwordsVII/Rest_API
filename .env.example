# Environment Configuration
ENVIRONMENT=local
DEBUG=false
APP_NAME=Project & Work Management API
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_secure_random_string_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rest_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Rate Limiting (Requests per minute per IP / User)
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
